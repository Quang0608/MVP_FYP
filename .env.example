OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=60
DATABASE_URL=sqlite:///./reroute_agent.db
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8501,http://127.0.0.1:8501
PORTWATCH_ENABLED=true
PORTWATCH_STATE_PATH=data/processed/portwatch/current_port_state.parquet
PORTWATCH_DISRUPTIONS_PATH=data/processed/portwatch/current_disruptions.parquet
PORTWATCH_AFFECTED_PORTS_PATH=data/processed/portwatch/disruption_affected_ports.parquet
RUNTIME_LOCATION_MAPPING_PATH=data/mappings/runtime_location_mapping.csv
OPEN_METEO_ENABLED=false
OPEN_METEO_FORECAST_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_BASE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_REQUEST_TIMEOUT_SECONDS=20
OPEN_METEO_RETRY_COUNT=2
OPEN_METEO_CACHE_TTL_MINUTES=30
OPEN_METEO_RAW_SNAPSHOT_DIRECTORY=data/raw/weather/open_meteo
OPEN_METEO_CACHE_DIRECTORY=data/cache/weather/open_meteo
OPEN_METEO_MAX_COORDINATES_PER_REQUEST=50
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
