{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supply-chain-reroute.local/schemas/portwatch_disruption_affected_ports.schema.json",
  "title": "Canonical PortWatch Disruption Affected Port",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "location_id": { "type": "string", "minLength": 1 },
    "source_port_id": { "type": ["string", "null"] },
    "source_port_name": { "type": "string", "minLength": 1 },
    "match_method": { "type": "string", "minLength": 1 },
    "match_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "required": ["event_id", "location_id", "source_port_id", "source_port_name", "match_method", "match_confidence"]
}
