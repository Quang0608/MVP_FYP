{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supply-chain-reroute.local/schemas/disruption_events.schema.json",
  "title": "Canonical Disruption Event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": { "enum": ["PORT_CLOSURE", "PORT_CONGESTION", "FACTORY_SHUTDOWN", "WEATHER", "TYPHOON", "STRIKE", "ROUTE_BLOCKAGE", "GEOPOLITICAL_EVENT", "CAPACITY_REDUCTION"] },
    "location_id": { "type": ["string", "null"] },
    "route_id": { "type": ["string", "null"] },
    "start_time": { "type": "string", "format": "date-time" },
    "end_time": { "type": "string", "format": "date-time" },
    "severity": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "capacity_reduction": { "type": "number", "minimum": 0, "maximum": 1 },
    "delay_penalty_hours": { "type": "number", "minimum": 0 },
    "risk_penalty": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 }
  },
  "required": ["event_id", "event_type", "location_id", "route_id", "start_time", "end_time", "severity", "capacity_reduction", "delay_penalty_hours", "risk_penalty", "confidence", "source", "description"],
  "anyOf": [
    { "properties": { "location_id": { "type": "string" } } },
    { "properties": { "route_id": { "type": "string" } } }
  ]
}
