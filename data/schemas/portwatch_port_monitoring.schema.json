{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supply-chain-reroute.local/schemas/portwatch_port_monitoring.schema.json",
  "title": "Canonical PortWatch Port Monitoring",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "location_id": { "type": "string", "minLength": 1 },
    "observation_date": { "type": "string", "format": "date" },
    "port_calls_total": { "type": ["number", "null"], "minimum": 0 },
    "port_calls_container": { "type": ["number", "null"], "minimum": 0 },
    "port_calls_dry_bulk": { "type": ["number", "null"], "minimum": 0 },
    "port_calls_general_cargo": { "type": ["number", "null"], "minimum": 0 },
    "port_calls_roro": { "type": ["number", "null"], "minimum": 0 },
    "port_calls_tanker": { "type": ["number", "null"], "minimum": 0 },
    "import_total": { "type": ["number", "null"], "minimum": 0 },
    "import_container": { "type": ["number", "null"], "minimum": 0 },
    "import_dry_bulk": { "type": ["number", "null"], "minimum": 0 },
    "import_general_cargo": { "type": ["number", "null"], "minimum": 0 },
    "import_roro": { "type": ["number", "null"], "minimum": 0 },
    "import_tanker": { "type": ["number", "null"], "minimum": 0 },
    "export_total": { "type": ["number", "null"], "minimum": 0 },
    "export_container": { "type": ["number", "null"], "minimum": 0 },
    "export_dry_bulk": { "type": ["number", "null"], "minimum": 0 },
    "export_general_cargo": { "type": ["number", "null"], "minimum": 0 },
    "export_roro": { "type": ["number", "null"], "minimum": 0 },
    "export_tanker": { "type": ["number", "null"], "minimum": 0 },
    "source_port_id": { "type": ["string", "null"] },
    "source": { "const": "PORTWATCH" },
    "ingested_at": { "type": "string", "format": "date-time" }
  },
  "required": ["location_id", "observation_date", "port_calls_total", "port_calls_container", "port_calls_dry_bulk", "port_calls_general_cargo", "port_calls_roro", "port_calls_tanker", "import_total", "import_container", "import_dry_bulk", "import_general_cargo", "import_roro", "import_tanker", "export_total", "export_container", "export_dry_bulk", "export_general_cargo", "export_roro", "export_tanker", "source_port_id", "source", "ingested_at"]
}
