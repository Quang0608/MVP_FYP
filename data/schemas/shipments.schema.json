{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supply-chain-reroute.local/schemas/shipments.schema.json",
  "title": "Canonical Shipment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "shipment_id": { "type": "string", "minLength": 1 },
    "order_id": { "type": "string", "minLength": 1 },
    "customer_id": { "type": "string", "minLength": 1 },
    "origin_location_id": { "type": "string", "minLength": 1 },
    "destination_location_id": { "type": "string", "minLength": 1 },
    "current_location_id": { "type": "string", "minLength": 1 },
    "vessel_id": { "type": ["string", "null"] },
    "priority": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "planned_departure": { "type": "string", "format": "date-time" },
    "required_delivery_time": { "type": "string", "format": "date-time" },
    "current_eta": { "type": "string", "format": "date-time" },
    "status": { "enum": ["PLANNED", "IN_TRANSIT", "AT_RISK", "DELAYED", "DELIVERED", "REROUTED", "CANCELLED"] },
    "cargo_value": { "type": "number", "minimum": 0 },
    "weight_kg": { "type": "number", "exclusiveMinimum": 0 }
  },
  "required": ["shipment_id", "order_id", "customer_id", "origin_location_id", "destination_location_id", "current_location_id", "vessel_id", "priority", "planned_departure", "required_delivery_time", "current_eta", "status", "cargo_value", "weight_kg"]
}
