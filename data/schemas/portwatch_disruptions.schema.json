{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supply-chain-reroute.local/schemas/portwatch_disruptions.schema.json",
  "title": "Canonical PortWatch Disruption",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": { "type": ["string", "null"] },
    "event_name": { "type": ["string", "null"] },
    "description": { "type": ["string", "null"] },
    "alert_level": { "type": ["string", "null"] },
    "severity_text": { "type": ["string", "null"] },
    "country": { "type": ["string", "null"] },
    "start_time": { "type": ["string", "null"], "format": "date-time" },
    "end_time": { "type": ["string", "null"], "format": "date-time" },
    "last_updated": { "type": ["string", "null"], "format": "date-time" },
    "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
    "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
    "affected_ports_raw": { "type": ["string", "null"] },
    "affected_port_count": { "type": ["integer", "null"], "minimum": 0 },
    "affected_population": { "type": ["string", "null"] },
    "source_page_id": { "type": ["string", "null"] },
    "source": { "const": "PORTWATCH" },
    "ingested_at": { "type": "string", "format": "date-time" }
  },
  "required": ["event_id", "source", "ingested_at"]
}
